# Copy to .env and fill in. Everything that differs between customer shops lives here,
# in public/brand/ (logo, icon, images) and brand/messages/ (wording). Never edit code for a customer.

# ── Brand ──────────────────────────────────────────────────────────────
APP_NAME=My Shop
APP_DESCRIPTION=An online shop built on the custom shop template.

# Paths under public/ or full URLs. Replace the files in public/brand/ or point elsewhere.
BRAND_LOGO=/brand/logo.svg
BRAND_ICON=/brand/icon.svg
# BRAND_OG_IMAGE=/brand/og.jpg          # social preview image (defaults to the logo)
# BRAND_HERO_IMAGE=/brand/hero.jpg      # home page hero (defaults to the logo on a gradient)
# BRAND_SHOW_NAME=false                 # hide the name next to the logo (logo already has it)

# light | dark | system (system adds a light/dark toggle to the header)
BRAND_THEME=light

# Colors: any token from assets/styles/globals.css as BRAND_COLOR_<TOKEN>.
# BRAND_COLOR_* applies in light and dark; BRAND_DARK_COLOR_* overrides dark only.
# Use hex values, emails reuse them.
# BRAND_COLOR_PRIMARY=#4F46E5
# BRAND_COLOR_PRIMARY_FOREGROUND=#FFFFFF
# BRAND_COLOR_ACCENT=#4F46E5
# BRAND_COLOR_BACKGROUND=#FFFFFF
# BRAND_COLOR_FOREGROUND=#18181B
# BRAND_COLOR_CARD=#FFFFFF
# BRAND_COLOR_MUTED=#F4F4F5
# BRAND_COLOR_BORDER=#E4E4E7
# BRAND_COLOR_RING=#4F46E5
# BRAND_DARK_COLOR_BACKGROUND=#0B0B0F
# BRAND_RADIUS=0.75rem
# BRAND_FONT_DISPLAY_URL=/brand/display.woff2   # headings font

# ── Contact (each one is optional; the contact page hides when none is set) ─
# CONTACT_EMAIL=hello@myshop.com
# CONTACT_PHONE=+34 600 000 000
# WHATSAPP_NUMBER=34600000000           # makes the phone a WhatsApp link
# INSTAGRAM_ACCOUNT=myshop

# ── Languages ──────────────────────────────────────────────────────────
# Any of: en, es, de, fr, it (all when unset)
# LOCALES=en,es
# DEFAULT_LOCALE=en

# ── Shop rules ─────────────────────────────────────────────────────────
# Changing NEXT_PUBLIC_* values needs a rebuild.
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_NUMBER_LOCALE=de-DE
TAX_RATE=0
SHIPPING_PRICE=10
FREE_SHIPPING_THRESHOLD=100
PAYMENT_METHODS=PayPal, Stripe, CashOnDelivery
DEFAULT_PAYMENT_METHOD=PayPal
PAGE_SIZE=12
LATEST_PRODUCTS_LIMIT=4

# ── Infrastructure ─────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/shop
AUTH_SECRET=                            # npx auth secret
ENCRYPTION_KEY=

# Google login shows only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APPID=

RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
