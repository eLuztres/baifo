# Copy to .env and fill in. Everything that differs between customer shops lives here,
# in public/brand/ (logo, icon, images) and brand/messages/ (wording). Never edit code for a customer.

# ── Brand ──────────────────────────────────────────────────────────────
APP_NAME=My Shop
APP_DESCRIPTION=An online shop built on the custom shop template.

# Paths under public/ or full URLs. Replace the files in public/brand/ or point elsewhere.
BRAND_LOGO=/brand/logo.svg
# BRAND_LOGO_DARK=/brand/logo-dark.png   # the logo in dark mode (light lines); default: BRAND_LOGO
# BRAND_LOGO_ANIMATED=/brand/logo-alive.svg        # header: an animated mark (e.g. the logo's figure, SVG that stops with "reduce motion") with the wordmark beside it; default: off
# BRAND_LOGO_ANIMATED_DARK=/brand/logo-alive-dark.svg  # the animated mark in dark mode; default: BRAND_LOGO_ANIMATED
# BRAND_LOGO_WORDMARK=/brand/wordmark.png          # the wordmark beside the animated mark; default: the shop name as text
# BRAND_LOGO_WORDMARK_DARK=/brand/wordmark-dark.png  # the wordmark in dark mode; default: BRAND_LOGO_WORDMARK
# BRAND_LOGO_HEIGHT=64                    # logo height in the header in px (tablets up, phones 3/4), at most 72; default: 64
BRAND_ICON=/brand/icon.svg
# BRAND_OG_IMAGE=/brand/og.jpg          # social preview image (defaults to the logo)
# BRAND_HERO_IMAGE=/brand/hero.jpg      # home page hero (defaults to the logo on a gradient)
# BRAND_SHOW_NAME=false                 # hide the name next to the logo (logo already has it)
# BRAND_SHOW_SIGN_IN=false              # hide the sign-in / "Join" button from visitors (admins use /sign-in); hidden anyway with SHOWCASE_MODE + SIGN_UP_BY_INVITE
# BRAND_DECORATION=goldleaf            # dark background with the gold genie lamp breathing out smoke
# BRAND_DECORATION=dunes               # light background with soft drifting sand dunes and a low sun (colors from the theme)
# BRAND_LOADER_IMAGE=/brand/loader.png # a picture that hops while a page loads (default: the turning ring)
# BRAND_CONTACT_IMAGE=/brand/loader.png # the mascot waving hello in the contact pop-up, drawn in the text color (default: BRAND_LOADER_IMAGE, else a waving hand)
# BRAND_STAMP=/brand/stamp.png        # a small mark in the corner of item pictures (transparent PNG or SVG, drawn in white)
# BRAND_RING_CENTER=/brand/ring-center.svg # the category ring's middle: band (default, the gold band), none, or a picture turning as a 3D piece
# BRAND_RING_FIGURE=/brand/ring-figure.svg # a picture standing on that piece, its foot at the bottom middle (e.g. a windmill)
# BRAND_RING_FIGURE_SPINNER=/brand/ring-figure-spinner.svg # a part of it turning about its middle with the ring (the sails)
# BRAND_RING_FIGURE_AT=0.5,0.5          # where the figure stands on the piece, as shares of its width and height
# BRAND_LAMP_IMAGE=/brand/logo.png     # goldleaf: a picture instead of the drawn lamp (its bottom edge = the lamp's foot)
# BRAND_LAMP_SPOUT=0.9,0.7             # where the smoke leaves that picture, as shares of its width and height

# light | dark | system (system adds a light/dark toggle to the header)
BRAND_THEME=light
# true: with light or dark as the start, visitors can still switch (in the language menu and the phone menu)
# BRAND_THEME_SWITCH=true

# Colors: any token from assets/styles/globals.css as BRAND_COLOR_<TOKEN>.
# BRAND_COLOR_* applies in light and dark; BRAND_DARK_COLOR_* overrides dark only.
# Use hex values in quotes (an unquoted # starts a comment) or without the #, e.g. 4F46E5.
# BRAND_COLOR_PRIMARY="#4F46E5"
# BRAND_COLOR_PRIMARY_FOREGROUND="#FFFFFF"
# BRAND_COLOR_ACCENT="#4F46E5"
# BRAND_COLOR_BACKGROUND="#FFFFFF"
# BRAND_COLOR_FOREGROUND="#18181B"
# BRAND_COLOR_CARD="#FFFFFF"
# BRAND_COLOR_MUTED="#F4F4F5"
# BRAND_COLOR_BORDER="#E4E4E7"
# BRAND_COLOR_INLAY="#2BB3B1"          # the bottom line in the gold band of the category ring
# BRAND_COLOR_INLAY_TOP="#B3192F"      # the top line in that band
# BRAND_COLOR_DUNE="#F3C455"           # the sand dunes at the bottom of the light home hero
# BRAND_COLOR_RING="#4F46E5"
# BRAND_DARK_COLOR_BACKGROUND="#0B0B0F"
# BRAND_RADIUS=0.75rem
# BRAND_FONT_DISPLAY_URL=/brand/display.woff2   # headings font

# ── Contact (each one is optional; the contact page hides when none is set) ─
# CONTACT_EMAIL=hello@myshop.com
# CONTACT_PHONE=+34 600 000 000
# WHATSAPP_NUMBER=34600000000           # makes the phone a WhatsApp link
# INSTAGRAM_ACCOUNT=myshop
# The website shows each one that is set; set a switch to false to hide it (the email still sends the shop's mail).
# The WhatsApp number is shown when CONTACT_PHONE is unset.
# SHOW_CONTACT_EMAIL=true
# SHOW_CONTACT_PHONE=true
# SHOW_CONTACT_INSTAGRAM=true

# ── Service area ─────────────────────────────────────────────
# For now only here (e.g. a launch in one town): a notice above the header says so.
# Add places as you grow ("Corralejo, La Oliva"); remove it to serve everywhere.
# SERVICE_AREA=Corralejo

# ── Offers ────────────────────────────────────────────────────
# Big announcements (admin → Offers) on the home page and /ofertas, each with its own dates.
# On by default (nothing shows without a running offer); "false" removes them everywhere.
# OFFERS_ENABLED=false

# ── Languages ──────────────────────────────────────────────────────────
# Any of: en, es, de, fr, it (all when unset)
# LOCALES=en,es
# DEFAULT_LOCALE=en

# ── Shop rules ─────────────────────────────────────────────────────────
# Changing NEXT_PUBLIC_* values needs a rebuild.
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_NUMBER_LOCALE=de-DE
# Dates (orders, reviews) show in this IANA time zone on server and browser alike (default Europe/Madrid)
# NEXT_PUBLIC_SHOP_TIME_ZONE=Atlantic/Canary
# Showcase mode: no prices (never sent to the browser), no stock, no cart; visitors send "I'm interested" instead
# SHOWCASE_MODE=true
# Showcase with prices, e.g. classifieds: products with a contactPhone get "Contact the seller" instead of "I'm interested"
# SHOWCASE_SHOW_PRICES=true
TAX_RATE=0
SHIPPING_PRICE=10
FREE_SHIPPING_THRESHOLD=100
# PRICE_CLASSES=Essential:60, Classic:70   # optional: a product in a class takes the class price (npm run price-classes after changing)
PAYMENT_METHODS=PayPal, Stripe, CashOnDelivery
DEFAULT_PAYMENT_METHOD=PayPal
# Roles an admin can give users in /admin/users (comma-separated; "admin" unlocks the admin area)
# USER_ROLES=admin, user
PAGE_SIZE=12
# Hours a customer can reserve a product before paying (product page "Show interest")
RESERVATION_HOURS=48
# Hours a listing shows the "New" badge in the feed after it went live
NEW_LISTING_HOURS=48
# Days before a listing goes offline that it shows in the feed's "Ending soon"
ENDING_SOON_DAYS=3
# "Contact seller" reveals allowed per visitor IP within the minutes below (default 30 per 10 minutes)
# CONTACT_LIMIT_MAX=30
# CONTACT_LIMIT_MINUTES=10
# Admins land here after signing in (default /admin/overview)
# ADMIN_HOME_PATH=/admin/studio
# The shop owner's login email: only the owner can make, change or delete admins, and nobody can remove the owner
# (blank: every admin can manage every other admin)
# OWNER_EMAIL=owner@example.com
# Where the admin menu's "New product" leads (default: the AI studio, or the product form without OPENAI_API_KEY)
# ADMIN_NEW_PRODUCT_PATH=/admin/studio

# ── Infrastructure ─────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/shop
# DATABASE_URL_UNPOOLED=                # Neon's direct URL, used for migrations on Vercel (set by the Neon integration)
# Private preview / showcase app (docs/PREVIEW.md): every page asks for this shared password, and the site is noindex
# PREVIEW_PASSWORD=
AUTH_SECRET=                            # signs sessions (openssl rand -base64 32); BETTER_AUTH_SECRET works too
ENCRYPTION_KEY=

# Google login shows only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Nobody can sign up alone: an admin creates one-time invite links in Admin → Users (valid 14 days).
# Turn it on after the first admin exists, since they sign up normally (docs/SETUP.md).
# SIGN_UP_BY_INVITE=true

# Limits on public forms, per visitor IP (the *_LINK_ ones per private /publicar link); defaults shown
# SIGN_UP_LIMIT_MAX=5                   # sign-ups within SIGN_UP_LIMIT_MINUTES=60
# OWNER_MESSAGE_LIMIT_MAX=10            # "I'm interested" / "Reserve" messages within OWNER_MESSAGE_LIMIT_MINUTES=60
# LISTING_PAGE_LIMIT_MAX=30             # confirm / pay / "I paid" taps within LISTING_PAGE_LIMIT_MINUTES=60
# LISTING_LINK_LIMIT_MAX=20             # the same per link, within LISTING_LINK_LIMIT_MINUTES=60
# CLOSE_LISTING_LIMIT_MAX=10            # "Mark as sold" tries within CLOSE_LISTING_LIMIT_MINUTES=60
# CLOSE_LISTING_LINK_LIMIT_MAX=5        # the same per link (the seller's number can't be guessed), CLOSE_LISTING_LINK_LIMIT_MINUTES=60
# WHATSAPP_LISTING_LIMIT_MAX=10         # listings one WhatsApp number sends to the AI within WHATSAPP_LISTING_LIMIT_MINUTES=1440

PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APPID=

# ── Browser security (Content-Security-Policy) ───────────────────────────────
# Stripe, PayPal, UploadThing, Google sign-in and the map embed are allowed already.
# More https origins the pages may load from (pictures, fonts, scripts, frames), space- or comma-separated.
# CSP_EXTRA_ORIGINS=https://images.example.com https://cdn.example.com

RESEND_API_KEY=
# Gets an email for every new order (comma-separated; defaults to CONTACT_EMAIL).
# Admins can change it, turn emails off or add WhatsApp alerts under Admin > Overview > Notifications.
# ORDER_ALERT_EMAIL=owner@gmail.com
SENDER_EMAIL=onboarding@resend.dev

# AI product studio (/admin/studio and scripts/product-studio.mjs): OpenAI API key from platform.openai.com/api-keys.
# Without it, "New product" in the admin opens the plain product form. Prompts can be replaced in brand/studio.mjs.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare     # fast and cheap; gpt-image-2.5-sunburst is slower but more detailed
# OPENAI_IMAGE_QUALITY=high                  # low | medium | high | xhigh | max
# OPENAI_TEXT_MODEL=gpt-6-astra
# STUDIO_DIR=~/my-shop-studio          # local inbox/, out/ and cutouts/ folders (default: ~/<shop name>-studio)
# STUDIO_DRIVE_REMOTE=gdrive:myshop     # optional rclone remote + folder in Google Drive; rings/<id>/ holds each product's photos, views and data
# STUDIO_STYLE_IMAGE=/abs/path/style.png  # default: STUDIO_DIR/style.png; mood picture the AI copies scene and light from (not the product)
# STUDIO_STYLE_IMAGE_URL=/brand/studio-style.jpg  # the same mood picture for the admin studio (/admin/studio): a path under public/ or a full URL
# STUDIO_TEXT_LOCALE=es                   # language of the AI product texts (default: DEFAULT_LOCALE)

# ── Baifo marketplace: listing fees (all settings in docs/MARKETPLACE.md) ──
# How people pay the listing fee on their private page: stripe, paypal, bizum, cash (comma-separated)
LISTING_PAYMENT_METHODS=bizum,cash
# LISTING_PAYMENT_ON_PAGE=true        # plan, fee and payment on the private page; off: the fee is asked for at the start of the WhatsApp chat
# The number shown for Bizum payments (blank: Bizum isn't offered)
BIZUM_PHONE=
# Hours the private link of an unpaid listing stays valid, counted from when it was sent
UNPAID_LISTING_HOURS=48
