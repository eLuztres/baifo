generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  // A name of 1–3 words for small spaces (the store's ring row); the name shows where it's missing.
  shortName     String?
  slug          String      @unique(map: "product_slug_idx")
  category      String
  images        String[]
  brand         String
  description   String
  stock         Int
  price         Decimal     @default(0) @db.Decimal(12, 2)
  // A wanted ad's budget is a range: price is its lower end and this its upper end.
  priceMax      Decimal?    @db.Decimal(12, 2)
  priceClass    String?
  rating        Decimal     @default(0) @db.Decimal(3, 2)
  numReviews    Int         @default(0)
  isFeatured    Boolean     @default(false)
  banner        String?
  createdAt     DateTime    @default(now()) @db.Timestamp(6)
  OrderItem     OrderItem[]
  Review        Review[]
  imageIndex    Int         @default(0)
  // A reservation only counts while reservedUntil is in the future, so it ends by itself.
  reservedUntil DateTime?   @db.Timestamp(6)
  reservedById  String?     @db.Uuid
  reservedBy    User?       @relation(fields: [reservedById], references: [id], onDelete: SetNull)
  categories    Category[]
  // The maker's original photo; the AI views in `images` are regenerated from it when a category's scene changes.
  sourceImage    String?
  // The images before the last regeneration, so it can be undone.
  previousImages String[]  @default([])
  // The admin's order in the store; new rings keep 0 and so come first, newest first.
  sortOrder      Int       @default(0)
  // Classifieds: the seller's phone (WhatsApp) that buyers get on "Contact seller" instead of a cart.
  contactPhone   String?
  // Second-hand: how the item is (new, like_new, good, fair; PRODUCT_CONDITIONS); shown when set.
  condition      String?
  // Name, description and short name in other languages: { "en": { "name": "…", "description": "…", "shortName": "…" } }; a missing one shows its own.
  translations   Json      @default("{}")
  // Baifo: the private seller who listed it by WhatsApp, and when the listing goes offline.
  sellerId       String?   @db.Uuid
  seller         Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  expiresAt      DateTime? @db.Timestamp(6)
  submission     Submission?
  // Services and events never have a cart, only a contact; any type goes in any category.
  type           ListingType @default(PRODUCT)
  // Where it is handed over or offered; visitors filter the shop by places.
  placeId        String?   @db.Uuid
  place          Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  // A service's kind of offer: class, service or support (SERVICE_TYPES).
  serviceType    String?
  // An event: when it starts (it leaves the shop after that day) and where it is.
  startsAt       DateTime? @db.Timestamp(6)
  address        String?
}

// A town on the island the shop is in (or will be: not live yet shows as "soon"); the name is per language.
model Place {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique
  name        Json
  // Where its pin sits on public/brand/island.svg, in % of the picture's width and height.
  x           Float
  y           Float
  isLive      Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  products    Product[]
  submissions Submission[]
  corral      Corral?
}

// A place's "Corral": the real spot where people hand things over, get help and meet. Texts are per language.
model Corral {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId   String   @unique @db.Uuid
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String
  // A few welcoming words and the opening times: { "es": "…", "en": "…" }.
  text      Json     @default("{}")
  hours     Json     @default("{}")
  // The business that hosts it, e.g. a coworking.
  venue     String?
  address   String
  // For the map on its page; directions use the address.
  lat       Float?
  lng       Float?
  hostName  String?
  hostImage String?
  image     String?
  whatsapp  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
}

// A group in the store's category ring; the name and text are per language ({ "es": "…", "en": "…" }).
// Every listing is exactly one of these (LISTING_TYPES); WANTED is "Busco …", someone looking for something.
// CHECK constraints in the migration: priceMax only on WANTED, serviceType only on SERVICE, an EVENT product has startsAt.
enum ListingType {
  PRODUCT
  WANTED
  SERVICE
  EVENT
}

model Category {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String    @unique
  name          Json
  text          Json
  image         String?
  // Materials that put a ring in this category, e.g. "madera", "olivo".
  keywords      String[]  @default([])
  // The world the AI places this category's rings in; the variants keep neighbouring photos from looking alike.
  scene         String
  sceneVariants String[]  @default([])
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  products      Product[]
  // A subcategory; the store's ring only shows categories without a parent.
  parentId      String?    @db.Uuid
  parent        Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[] @relation("Subcategories")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique(map: "user_email_idx")
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  address       Json?     @db.Json
  paymentMethod String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  account       Account[]
  session       Session[]
  Cart          Cart[]
  Order         Order[]
  Review        Review[]
  reservations  Product[]
}

// Better Auth tables. Email/password logins are accounts with providerId "credential".
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt
}

model Cart {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  sessionCartId String
  items         Json[]   @default([]) @db.Json
  itemsPrice    Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  shippingPrice Decimal  @db.Decimal(12, 2)
  taxPrice      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @db.Uuid
  shippingAddress Json        @db.Json
  paymentMethod   String
  paymentResult   Json?       @db.Json
  itemsPrice      Decimal     @db.Decimal(12, 2)
  shippingPrice   Decimal     @db.Decimal(12, 2)
  taxPrice        Decimal     @db.Decimal(12, 2)
  totalPrice      Decimal     @db.Decimal(12, 2)
  isPaid          Boolean     @default(false)
  paidAt          DateTime?   @db.Timestamp(6)
  isDelivered     Boolean     @default(false)
  deliveredAt     DateTime?   @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @db.Timestamp(6)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderitems      OrderItem[]
}

model OrderItem {
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  qty       Int
  price     Decimal @db.Decimal(12, 2)
  name      String
  slug      String
  image     String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderId, productId], map: "orderitems_orderId_productId_pk")
}

model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  productId          String   @db.Uuid
  rating             Int
  title              String
  description        String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row (id 1): how the owner hears about orders and interested customers, set on the admin overview.
model ShopSettings {
  id             Int      @id @default(1)
  notifyEmail    Boolean  @default(true)
  // Comma-separated; empty means ORDER_ALERT_EMAIL / CONTACT_EMAIL from .env.
  alertEmails    String   @default("")
  notifyWhatsapp Boolean  @default(false)
  whatsappNumber String   @default("")
  // CallMeBot key: it only sends to the number that asked for it, i.e. the owner's own.
  whatsappApiKey String   @default("")
  // Which .env contact details the website shows; admins can hide each one.
  showEmail      Boolean  @default(true)
  showPhone      Boolean  @default(true)
  showInstagram  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

// ── Baifo marketplace: listings sent in by WhatsApp ──────────────────────

enum SubmissionStatus {
  COLLECTING
  PROCESSING
  IN_REVIEW
  AWAITING_PAYMENT
  LIVE
  EXPIRED
  SOLD
  REJECTED
}

// A private seller, known only by their WhatsApp number.
model Seller {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waId        String       @unique
  name        String?
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  submissions Submission[]
  products    Product[]
}

// One listing on its way from the seller's WhatsApp photos to a live product.
model Submission {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String           @db.Uuid
  seller            Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status            SubmissionStatus @default(COLLECTING)
  // WhatsApp media ids still to download, then the stored originals and the AI pictures.
  mediaIds          String[]         @default([])
  rawImages         String[]         @default([])
  images            String[]         @default([])
  rawText           String           @default("")
  title             String?
  // The product's shortName in the shop's language.
  shortTitle        String?
  description       String?
  // Title, description and short title in the shop's other languages: { "en": { "title": "…", "description": "…", "short": "…" } }.
  translations      Json             @default("{}")
  // The store category's slug, as the AI recognized it or the admin chose it.
  category          String?
  // How the item is, as the AI saw it (PRODUCT_CONDITIONS); the product takes it over.
  condition         String?
  price             Decimal?         @db.Decimal(12, 2)
  // A wanted ad's budget is a range: price is its lower end and this its upper end.
  priceMax          Decimal?         @db.Decimal(12, 2)
  plan              String?
  crossPostFacebook Boolean          @default(false)
  crossPostWallapop Boolean          @default(false)
  hasContactConsent Boolean          @default(false)
  // Secret part of the seller's /publicar link.
  payToken          String           @unique @default(dbgenerated("gen_random_uuid()::text"))
  paymentProvider   String?
  paidAt            DateTime?        @db.Timestamp(6)
  productId         String?          @unique @db.Uuid
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  expiresAt         DateTime?        @db.Timestamp(6)
  // When the seller was told the listing ends soon.
  remindedAt        DateTime?        @db.Timestamp(6)
  // Made on /admin/listings/new: no WhatsApp review, the admin sees the result right away.
  createdByAdmin    Boolean          @default(false)
  // The product it becomes takes it over.
  type              ListingType      @default(PRODUCT)
  // Its place; the product it becomes takes it over.
  placeId           String?          @db.Uuid
  place             Place?           @relation(fields: [placeId], references: [id], onDelete: SetNull)
  // A service's kind of offer and an event's start and address; the product it becomes takes them over.
  serviceType       String?
  startsAt          DateTime?        @db.Timestamp(6)
  address           String?
  // Which text is in use: 'original' (the admin's own words, only translated) or 'ai' (improved by the AI).
  textMode          String           @default("ai")
  // The admin's own title for 'original'; the original description is rawText.
  originalTitle     String?
  // Both texts in every shop language, so switching never pays the AI twice: { "ai": { "es": { "title", "description" } } }.
  textVersions      Json             @default("{}")
  // The AI picture of each original photo, at the same index as rawImages ('' where the AI made none).
  aiImages          String[]         @default([])
  // False when the admin went on without AI: photos and videos stay exactly as uploaded.
  usesAi            Boolean          @default(true)
  // ❌ Rechazar was tapped on WhatsApp: the admin's next text is the reason the seller gets.
  rejectAskedAt     DateTime?        @db.Timestamp(6)
  // Why the admin rejected it, as the seller got it.
  rejectReason      String?
  // Proof of the person's OK to show their number: when, where ('publish-page' or 'whatsapp-reply') and which text they saw.
  consentAt         DateTime?        @db.Timestamp(6)
  consentSource     String?
  consentTextVersion String?
  // What the person writes as the Bizum concept, e.g. BAIFO-7Q2K.
  payCode           String?          @unique
  // When the private link was last sent; an unpaid listing expires counted from here.
  sentAt            DateTime?        @db.Timestamp(6)
  fees              ListingFee[]
  attempts          Int              @default(0)
  lastError         String?
  createdAt         DateTime         @default(now()) @db.Timestamp(6)
  updatedAt         DateTime         @updatedAt

  @@index([sellerId, status])
}

// A listing fee as it was paid, for the books; it keeps the title when the listing is deleted.
model ListingFee {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String?     @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  title        String
  // 'bizum', 'cash', 'stripe' or 'paypal'.
  method       String
  amount       Decimal     @db.Decimal(12, 2)
  payCode      String?
  // The admin who marked it paid; empty for card payments.
  recordedBy   String?
  paidAt       DateTime    @default(now()) @db.Timestamp(6)

  @@index([paidAt])
}

// Inbound WhatsApp message ids: Meta can deliver a webhook more than once.
model WhatsappMessage {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

// Baifo's own admin settings (one row, id "default").
model MarketplaceSettings {
  id            String   @id @default("default")
  // Gets the printable list of all live listings; LISTINGS_EMAIL in .env until it is set here.
  listingsEmail String?
  // Also send the list by itself after every new listing, not only on "Enviar lista".
  sendOnPublish Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// Failed password sign-ins per email and IP, to stop password guessing; rows older than the window are deleted.
model FailedSignIn {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  ip        String
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([email, ip, createdAt])
}

// One OpenAI call and what it cost, for the admin's AI costs page.
model AiUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // picture, text, voice or check (AI_USAGE_KINDS)
  kind         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // USD from OpenAI's token prices at the time of the call; 0 for a model without a known price.
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
}

// A link the admin gives someone so they can create an account (SIGN_UP_BY_INVITE); it works once.
model Invite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The secret part of /invite/<token>.
  token       String    @unique
  // Who it is for, so the admin recognizes it in the list.
  note        String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  expiresAt   DateTime  @db.Timestamp(6)
  usedAt      DateTime? @db.Timestamp(6)
  usedByEmail String?
}
